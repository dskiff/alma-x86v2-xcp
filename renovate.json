{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customDatasources": {
    "almalinux-iso": {
      "description": "AlmaLinux boot ISO versions and SHA256 digests, parsed from the clearsigned CHECKSUM file that sits next to the ISO (lines look like 'SHA256 (AlmaLinux-9.8-x86_64-boot.iso) = <hex>'). Renovate doesn't check the signature; CI does, with verify-iso.sh.",
      "defaultRegistryUrlTemplate": "{{{packageName}}}",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases.$match(version, /^SHA256 \\(AlmaLinux-(\\d+\\.\\d+)-\\w+-boot\\.iso\\) = ([0-9a-f]{64})$/).{\"version\": groups[0], \"digest\": groups[1]}]}"
      ]
    },
    "rpm-repomd": {
      "description": "A yum repository's metadata revision, from its repodata/repomd.xml (the line '<revision>N</revision>'). It changes whenever the repository's packages do.",
      "defaultRegistryUrlTemplate": "{{{packageName}}}repodata/repomd.xml",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases.$match(version, /^\\s*<revision>(\\d+)<\\/revision>\\s*$/).{\"version\": groups[0]}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the AlmaLinux boot ISO (iso_url + iso_checksum) in Packer templates.",
      "managerFilePatterns": [
        "/^.+\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "iso_url\\s*=\\s*\"(?<isoDir>https://[^\"]+)/AlmaLinux-(?<currentValue>(?<major>\\d+)\\.\\d+)-(?<arch>\\w+)-boot\\.iso\"\\s+iso_checksum\\s*=\\s*\"sha256:(?<currentDigest>[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "custom.almalinux-iso",
      "depNameTemplate": "AlmaLinux {{{major}}} {{{arch}}} boot ISO",
      "packageNameTemplate": "{{{isoDir}}}/CHECKSUM",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Bump the exact Packer plugin pins in required_plugins (Packer has no plugin lockfile). A source of github.com/<owner>/<name> is the GitHub repo <owner>/packer-plugin-<name>.",
      "managerFilePatterns": [
        "/^.+\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "version\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s+source\\s*=\\s*\"github\\.com/(?<owner>[\\w.-]+)/(?<name>[\\w.-]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{owner}}}/packer-plugin-{{{name}}}",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the gh-actions-lock extension that CI verifies .github/workflows/actions.lock with.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "gh extension install (?<depName>github/gh-actions-lock) --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Notice when a repository in an RPM lockfile changes. Renovate only bumps the revision; .github/workflows/rpm-lock.yml then rewrites the lockfile on Renovate's PR (Renovate can't resolve RPM dependencies).",
      "managerFilePatterns": [
        "/^rpms/[^/]+\\.lock$/"
      ],
      "matchStrings": [
        "(?:^|\\n)repo (?<depName>\\S+) (?<packageName>https://\\S+) (?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "custom.rpm-repomd",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for every RPM repository change, since the lockfiles are rewritten whole.",
      "matchDatasources": [
        "custom.rpm-repomd"
      ],
      "groupName": "RPM repositories",
      "separateMajorMinor": false
    }
  ]
}
